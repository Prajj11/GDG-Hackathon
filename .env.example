VITE_API_URL=/api
# Optional public display label, applied when building the frontend (not a login).
VITE_GUARDIAN_DISPLAY_NAME=Guardian workspace

# Optional backend process environment (FastAPI does not auto-load this file).
# Local demo works without guardian login. Set these to enable single-guardian JWT login.
GUARDIAN_USERNAME=guardian
GUARDIAN_PASSWORD_HASH=
JWT_SECRET=
